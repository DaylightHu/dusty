#!/bin/sh

task=${0##*/}

fail()
{
    printf '%s: %s\n' "$task" "$*" >&2
    exit 1
}

[ -n "${MCMUX_PROJECT:-}" ] && [ -n "${MCMUX_RUN_FD:-}" ] ||
    fail 'Run this command from a mcmux terminal pane.'

if [ "$task" = mcmodel ] && { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; }; then
    cd "$MCMUX_PROJECT" || exit 1
    exec ./nob export-c "$@"
fi

[ "$#" -eq 1 ] || fail "Usage: $task FILE.c"
case "$1" in
    /*) source=$1 ;;
    *) source=$PWD/$1 ;;
esac
case "$source" in
    *.c) [ -f "$source" ] || fail "C file not found: $source" ;;
    *) fail "Expected a C file: $source" ;;
esac

cd "$MCMUX_PROJECT" || exit 1
case "$task" in
    mcmake) exec ./nob build-c "$source" ;;
    mcrun)
        [ -n "${MCMUX_HOST:-}" ] || fail 'Cannot locate the mcmux host.'
        exec "$MCMUX_HOST" --run-driver "$source"
        ;;
    mcmodel)
        annotation=
        found=false
        while IFS= read -r line || [ -n "$line" ]; do
            line=${line#"${line%%[![:space:]]*}"}
            case "$line" in
                //*) line=${line#//} ;;
                *) continue ;;
            esac
            line=${line#"${line%%[![:space:]]*}"}
            case "$line" in
                mcmux-model:*)
                    [ "$found" = false ] || fail 'Keep one // mcmux-model: annotation.'
                    annotation=${line#mcmux-model:}
                    found=true
                    ;;
            esac
        done < "$source"
        [ "$found" = true ] || fail 'Add // mcmux-model: INPUT.mcs OUTPUT.c SYMBOL.'

        # Split the three annotation fields without expanding pathname patterns.
        set -f
        IFS=$(printf ' \t\r\n_')
        IFS=${IFS%_}
        set -- $annotation
        [ "$#" -eq 3 ] || fail 'Expected // mcmux-model: INPUT.mcs OUTPUT.c SYMBOL.'
        exec ./nob export-c "$@"
        ;;
esac
